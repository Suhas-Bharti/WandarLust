<% layout("/layouts/boilerplate") %>

    <body>
        <h2 class="mb-4 fw-bold text-center" style="color:#fe424d;"> Create New Listing </h2>
        <div class="row mb-5">
            <div class="form-card col-8 offset-2">
                <form method="post" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="title" class="form-label fw-semibold">Title</label>
                        <input type="text" id="title" name="listing[title]" class="form-control custom-input" placeholder="Enter listing title"
                            required>
                        <div class="valid-feedback">Title looks good!</div>
                        <div class="invalid-feedback">Please enter a valid title.</div>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label fw-semibold">Description</label>
                        <textarea id="description" name="listing[description]" rows="4" class="form-control custom-input"
                            placeholder="Enter listing description" required></textarea>
                        <div class="valid-feedback">Description looks good!</div>
                        <div class="invalid-feedback">Please enter a short description.</div>
                    </div>
                    <div class="mb-3">
                        <label for="image" class="form-label fw-semibold">Upload Image</label>
                        <input type="file" id="image" name="listing[image]" class="form-control custom-input"/>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3 ">
                            <label for="price" class="form-label fw-semibold">Price</label>
                            <input type="number" id="price" name="listing[price]" class="form-control custom-input" placeholder="₹1200"
                                required />
                            <div class="valid-feedback">Price looks good!</div>
                            <div class="invalid-feedback">Price should be valid.</div>
                        </div>
                        <div class="col-md-8 mb-3">
                            <label for="location" class="form-label fw-semibold">Location</label>
                            <input type="text" id="location" name="listing[location]" class="form-control custom-input"
                                placeholder="Enter city/location" required />
                            <div class="valid-feedback">Location looks good!</div>
                            <div class="invalid-feedback">Location name should be valid.</div>
                        </div>
                    </div>
                    <div class="mb-5">
                        <label for="country" class="form-label fw-semibold">Country</label>
                        <input type="text" id="country" name="listing[country]" class="form-control custom-input" placeholder="Enter country name"
                            required />
                        <div class="valid-feedback">Country looks good!</div>
                        <div class="invalid-feedback">Country name should be valid.</div>
                    </div>

                    <div class="d-flex justify-content-center">
                        <button type="submit" class="btn btn-dark add-btn px-4 py-2 fw-semibold">
                            Add Listing
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </body>