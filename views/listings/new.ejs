<% layout("/layouts/boilerplate") %>

    <body>
        <h2 class="mb-4 fw-bold text-center" style="color:#fe424d;"> Create New Listing </h2>
        <div class="row mb-5">
            <div class="form-card col-8 offset-2">
                <form method="post" action="/listings">
                    <div class="mb-3">
                        <label for="title" class="form-lable fw-semibold">Title</label>
                        <input type="text" id="title" name="title" class="form-control custom-input" placeholder="Enter listing title"
                            required>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-lable fw-semibold">Description</label>
                        <textarea id="description" name="description" rows="4" class="form-control custom-input"
                            placeholder="Enter listing description" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="image" class="form-lable fw-semibold">Image URL</label>
                        <input type="text" id="image" name="image" class="form-control custom-input" placeholder="Paste image link here"
                            required />
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3 ">
                            <label for="price" class="form-lable fw-semibold">Price</label>
                            <input type="number" id="price" name="price" class="form-control custom-input" placeholder="₹1200"
                                required />
                        </div>
                        <div class="col-md-8 mb-3">
                            <label for="location" class="form-lable fw-semibold">Location</label>
                            <input type="text" id="location" name="location" class="form-control custom-input"
                                placeholder="Enter city/location" required />
                        </div>
                    </div>
                    <div class="mb-5">
                        <label for="country" class="form-lable fw-semibold">Country</label>
                        <input type="text" id="country" name="country" class="form-control custom-input" placeholder="Enter country name"
                            required />
                    </div>

                    <div class="d-flex justify-content-center">
                        <button type="submit" class="btn btn-dark add-btn px-4 py-2 fw-semibold">
                            Create Listing
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </body>