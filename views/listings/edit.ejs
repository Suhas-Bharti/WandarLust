<% layout("/layouts/boilerplate") %>

    <body>
        <h3>Edit Your Listing</h3>
        <form method="post" action="/listings/<%= listing._id %>?_method=PUT">
            <label for="title">Title:</label>
            <input type="text" id="title" name="title" placeholder="Enter title" required value="<%= listing.title %>">
            <br /><br />

            <label for="description">Description:</label><br>
            <textarea id="description" name="description" rows="4" cols="50" placeholder="Enter description"
                required><%= listing.description %></textarea>
            <br /><br />

            <label for="image">Image:</label>
            <input type="text" id="image" name="image" placeholder="Enter image URL" required
                value="<%= listing.image %>" />
            <br /><br />

            <label for="price">Price:</label>
            <input type="number" id="price" name="price" placeholder="Enter price" required
                value="<%= listing.price %>" />
            <br /><br />

            <label for="location">Location:</label>
            <input type="text" id="location" name="location" placeholder="Enter location" required
                value="<%= listing.location %>" />
            <br /><br />

            <label for="country">Country:</label>
            <input type="text" id="country" name="country" placeholder="Enter country" required
                value="<%= listing.country %>" />
            <br /><br />

            <button type="submit">Update Listing</button>
        </form>
    </body>