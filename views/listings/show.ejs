<% layout("/layouts/boilerplate") %>

    <body>
        <h2 class="mb-4 fw-bold text-center" style="color:#fe424d;">
            <%= listing.title %>
        </h2>

        <div class="row mb-5">
            <div class="col col-md-8 offset-md-2">

                <div class=" card p-3 shadow-sm">

                    <img src="<%= listing.image %>" class="img-fluid show-image mb-4" alt="listing_image">

                    <p class="card-text"> Owned by:
                        <span class="fw-semibold">
                            <i>
                                <%= listing.owner.username %>
                            </i>
                        </span>
                    </p>

                    <p class="card-text">
                        <%= listing.description %>
                    </p>

                    <h5 class="fw-bold text-danger mb-2">
                        ₹<%= listing.price.toLocaleString("en-IN") %>
                    </h5>

                    <p class=" card-text mb-1">
                        <i class="bi bi-geo-alt-fill text-danger"></i>
                        <%= listing.location %>, <%= listing.country %>
                    </p>

                    <% if(currentUser && listing.owner._id.equals(currentUser._id)) { %>
                        <div class="d-flex gap-5 mt-4 mb-4">
                            <form method="get" action="/listings/<%= listing._id %>/edit">
                                <button type="submit" class="btn btn-dark px-4">
                                    Edit
                                </button>
                            </form>

                            <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
                                <button type="submit" class="btn btn-danger px-4">
                                    Delete
                                </button>
                            </form>
                        </div>
                        <% } %>



                            <!-- Create Review form -->
                            <div class="col-8 offset-2 mt-1">
                                <!-- Only show review form if user is logged in -->
                                <% if(currentUser) { %>
                                    <div class="card p-4 ">
                                        <h4 class=" mb-4 fw-bold text-center" style="color:#fe424d;">
                                            Leave a Review
                                        </h4>

                                        <form action="/listings/<%= listing._id %>/reviews" method="post"
                                            class="needs-validation" novalidate>

                                            <!-- Rating Section -->
                                            <div class="mb-4 text-center">
                                                <label for="rating" class="form-label fw-semibold mb-2">
                                                    Rating
                                                </label>

                                                <input type="range" min="1" max="5" step="1" value="3" id="rating"
                                                    name="review[rating]" class="form-range w-75 mx-auto d-block" />

                                                <!-- Live Rating Display -->
                                                <div class="mt-2">
                                                    <span class="badge bg-danger fs-6 px-3 py-2 rounded-pill">
                                                        <span id="ratingValue">3</span> / 5 ⭐
                                                    </span>
                                                </div>
                                            </div>

                                            <!-- Comment Section -->
                                            <div class="mb-4">
                                                <label for="comment" class="form-label fw-semibold mb-2">
                                                    Share your experience
                                                </label>

                                                <textarea name="review[comment]" id="comment" rows="5"
                                                    class="form-control rounded-3 shadow-sm"
                                                    placeholder="Write your honest review here..." required></textarea>

                                                <div class="invalid-feedback">
                                                    Please write a review before submitting.
                                                </div>
                                            </div>

                                            <!-- Submit Button -->
                                            <div class="text-center">
                                                <button
                                                    class="btn btn-danger px-5 py-2 rounded-pill shadow-sm fw-semibold">
                                                    Submit Review
                                                </button>
                                            </div>
                                        </form>
                                        <% } %>
                                    </div>
                            </div>
                </div>
            </div>
        </div>
        <!-- Show Guest Reviews -->
        <div class="row mb-5">
            <div class="col-md-10 offset-md-1 border-top mt-5 pt-4">

                <h4 class="fw-bold mb-4 text-center" style="color:#fe424d;">
                    Guest Reviews
                </h4>

                <% if (!listing.reviews || listing.reviews.length===0) { %>

                    <p class="text-muted text-center">
                        No reviews yet. Be the first to review!
                    </p>

                    <% } else { %>

                        <div class="row g-4">

                            <% for (let review of listing.reviews) { %>

                                <div class="col-12 col-md-6">
                                    <div class="card shadow-sm border-0 rounded-4 h-100 review-card">
                                        <div class="card-body">

                                            <!-- Header Section -->
                                            <div class="d-flex justify-content-between align-items-start mb-2">

                                                <div>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="rounded-circle bg-danger text-white d-flex justify-content-center align-items-center"
                                                            style="width:40px;height:40px;font-size:14px;">
                                                            U
                                                        </div>
                                                        <span class="fw-semibold"> @<%= review.author.username %>
                                                        </span>
                                                    </div>

                                                    <!-- Time -->
                                                    <small class="text-muted">
                                                        <%= review.createdAt ? review.createdAt.toDateString()
                                                            : "Recently" %>
                                                    </small>
                                                </div>

                                                <!-- Rating -->
                                                <span class="badge bg-danger px-3 py-2 rounded-pill">
                                                    <%= review.rating %> ⭐
                                                </span>
                                            </div>

                                            <!-- Comment -->
                                            <p class="text-muted mt-2 mb-0"
                                                style="font-size: 0.95rem; line-height:1.6;">
                                                <%= review.comment %>
                                            </p>
                                            <!--Delete Review-->
                                            <form class="mt-3" method="post"
                                                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                                <button type="submit" class="btn btn-sm btn-dark">Delete</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                <% } %>

                        </div>

                        <% } %>

            </div>
        </div>
    </body>