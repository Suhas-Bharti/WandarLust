<% layout("/layouts/boilerplate") %>

    <body>
        <h2 class="mb-4 fw-bold text-center" style="color:#fe424d;">
            <%= listing.title %>
        </h2>

        <div class="row mb-5">
            <div class="col-md-8 offset-md-2">

                <div class=" card p-3 shadow-sm">

                    <img src="<%= listing.image %>" class="img-fluid show-image mb-4" alt="listing_image">

                    <p class="text-muted mb-3">
                        <%= listing.description %>
                    </p>

                    <h5 class="fw-bold text-danger mb-2">
                        ₹<%= listing.price.toLocaleString("en-IN") %>
                    </h5>

                    <p class="mb-1">
                        <i class="bi bi-geo-alt-fill text-danger"></i>
                        <%= listing.location %>, <%= listing.country %>
                    </p>

                    <div class="d-flex gap-5 mt-4 mb-4">
                        <form method="get" action="/listings/<%= listing._id %>/edit">
                            <button type="submit" class="btn btn-dark px-4">
                                Edit
                            </button>
                        </form>

                        <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
                            <button type="submit" class="btn btn-danger px-4">
                                Delete
                            </button>
                        </form>
                    </div>
                    <hr />

                    <!-- Create Review form -->
                    <div class="col-8 offset-2 mt-4">
                        <div class="card p-4 ">

                            <h4 class="mb-4 fw-bold text-center" style="color:#fe424d;">
                                Leave a Review
                            </h4>

                            <form action="/listings/<%= listing._id %>/reviews" method="post" class="needs-validation" novalidate>

                                <!-- Rating Section -->
                                <div class="mb-4 text-center">
                                    <lable for="rating" class="form-lable fw-semibold mb-2">
                                        Rating
                                    </lable>

                                    <input type="range" min="1" max="5" step="1" value="3" id="rating"
                                        name="review[rating]" class="form-range w-75 mx-auto d-block" />

                                    <!-- Live Rating Display -->
                                    <div class="mt-2">
                                        <span class="badge bg-danger fs-6 px-3 py-2 rounded-pill">
                                            <span id="ratingValue">3</span> / 5 ⭐
                                        </span>
                                    </div>
                                </div>

                                <!-- Comment Section -->
                                <div class="mb-4">
                                    <label for="comment" class="form-lable fw-semibold mb-2">
                                        Share your experience
                                    </label>

                                    <textarea name="review[comment]" id="comment" rows="5"
                                        class="form-control rounded-3 shadow-sm"
                                        placeholder="Write your honest review here..." required></textarea>

                                    <div class="invalid-feedback">
                                        Please write a review before submitting.
                                    </div>
                                </div>

                                <!-- Submit Button -->
                                <div class="text-center">
                                    <button class="btn btn-danger px-5 py-2 rounded-pill shadow-sm fw-semibold">
                                        Submit Review
                                    </button>
                                </div>

                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </body>