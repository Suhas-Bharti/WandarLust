<% layout("/layouts/boilerplate") %>

<body>

    <!-- LISTING TITLE -->
    <h2 class="mb-4 fw-bold text-center text-danger">
        <%= listing.title %>
    </h2>

    <!-- LISTING SECTION -->
    <div class="row mb-5">
        <div class="col-md-8 offset-md-2">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- IMAGE -->
                <img src="<%= listing.image %>"
                    class="img-fluid show-image"
                    alt="listing_image">

                <div class="card-body p-4">

                    <!-- OWNER -->
                    <p class="card-text mb-2">
                        Owned by:
                        <span class="fw-semibold">
                            <i>@<%= listing.owner.username %></i>
                        </span>
                    </p>

                    <!-- DESCRIPTION -->
                    <p class="card-text text-muted">
                        <%= listing.description %>
                    </p>

                    <!-- PRICE -->
                    <h4 class="fw-bold text-danger mb-3">
                        ₹<%= listing.price.toLocaleString("en-IN") %>
                    </h4>

                    <!-- LOCATION -->
                    <p class="card-text">
                        <i class="bi bi-geo-alt-fill text-danger"></i>
                        <%= listing.location %>, <%= listing.country %>
                    </p>

                    <!-- EDIT & DELETE -->
                    <% if(currentUser && listing.owner._id.equals(currentUser._id)) { %>

                        <div class="d-flex gap-3 mt-4">

                            <form method="get"
                                action="/listings/<%= listing._id %>/edit">

                                <button class="btn btn-dark rounded-pill px-4">
                                    Edit
                                </button>

                            </form>

                            <form method="post"
                                action="/listings/<%= listing._id %>?_method=DELETE">

                                <button class="btn btn-danger rounded-pill px-4">
                                    Delete
                                </button>

                            </form>

                        </div>

                    <% } %>

                    <hr class="my-4">

                    <!-- REVIEW FORM -->
                    <% if(currentUser) { %>

                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-light">

                            <h4 class="fw-bold text-center text-danger mb-4">
                                Leave a Review
                            </h4>

                            <form action="/listings/<%= listing._id %>/reviews"
                                method="post">

                                <!-- RATING -->
                                <div class="mb-4 text-center">

                                    <label for="rating"
                                        class="form-label fw-semibold">
                                        Rating
                                    </label>

                                    <input type="range"
                                        min="1"
                                        max="5"
                                        step="1"
                                        value="3"
                                        id="rating"
                                        name="review[rating]"
                                        class="form-range w-75 mx-auto">

                                    <div class="mt-2">

                                        <span class="badge bg-danger rounded-pill px-3 py-2 fs-6">
                                            <span id="ratingValue">3</span> ⭐
                                        </span>

                                    </div>

                                </div>

                                <!-- COMMENT -->
                                <div class="mb-4">

                                    <label for="comment"
                                        class="form-label fw-semibold">

                                        Your Experience

                                    </label>

                                    <textarea name="review[comment]"
                                        id="comment"
                                        rows="4"
                                        class="form-control rounded-3"
                                        placeholder="Write your review here..."
                                        required></textarea>

                                </div>

                                <!-- BUTTON -->
                                <div class="text-center">

                                    <button class="btn btn-danger rounded-pill px-5">
                                        Submit Review
                                    </button>

                                </div>

                            </form>

                        </div>

                    <% } else { %>

                        <!-- LOGIN MESSAGE -->
                        <div class="text-center mt-4">

                            <p class="text-muted mb-2">
                                Login to leave a review
                            </p>

                            <a href="/login"
                                class="btn btn-outline-danger rounded-pill px-4">

                                Login

                            </a>

                        </div>

                    <% } %>

                </div>
            </div>
        </div>
    </div>

    <!-- REVIEWS SECTION -->
    <div class="row mb-5">

        <div class="col-md-10 offset-md-1">

            <h3 class="text-center fw-bold text-danger mb-5">
                Guest Reviews
            </h3>

            <% if(!listing.reviews || listing.reviews.length === 0) { %>

                <p class="text-center text-muted">
                    No reviews yet. Be the first to review!
                </p>

            <% } else { %>

                <div class="row g-4">

                    <% for(let review of listing.reviews) { %>

                        <div class="col-md-6 d-flex">

                            <!-- REVIEW CARD -->
                            <div class="card border-0 shadow-sm rounded-4 p-3 w-100 d-flex flex-column">

                                <div class="card-body d-flex flex-column justify-content-between">

                                    <!-- TOP -->
                                    <div>

                                        <!-- USER + RATING -->
                                        <div class="d-flex justify-content-between align-items-start mb-3">

                                            <div>

                                                <h5 class="mb-1 fw-bold">
                                                    @<%= review.author ? review.author.username : "Anonymous" %>
                                                </h5>

                                                <small class="text-muted">

                                                    <%= review.createdAt
                                                        ? review.createdAt.toDateString()
                                                        : "Recently" %>

                                                </small>

                                            </div>

                                            <span class="badge bg-danger rounded-pill px-3 py-2">

                                                <%= review.rating %> ⭐

                                            </span>

                                        </div>

                                        <!-- COMMENT -->
                                        <p class="text-muted review-comment">

                                            <%= review.comment %>

                                        </p>

                                    </div>

                                    <!-- DELETE BUTTON -->
                                    <% if(currentUser && review.author &&
                                        review.author._id.equals(currentUser._id)) { %>

                                        <form method="post"
                                            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">

                                            <button class="btn btn-sm btn-dark rounded-pill px-3 mt-3">
                                                Delete
                                            </button>

                                        </form>

                                    <% } %>

                                </div>

                            </div>

                        </div>

                    <% } %>

                </div>

            <% } %>

        </div>

    </div>

    <!-- RATING SCRIPT -->
    <script>

        const rating = document.getElementById("rating");
        const ratingValue = document.getElementById("ratingValue");

        if (rating) {

            rating.addEventListener("input", () => {

                ratingValue.textContent = rating.value;

            });

        }

    </script>

    <!-- CUSTOM CSS -->
    <style>

        .show-image {
            height: 420px;
            object-fit: cover;
        }

        .review-comment {
            line-height: 1.7;
            font-size: 0.95rem;
            word-break: break-word;
        }

        .card {
            transition: 0.3s ease;
        }

        .card:hover {
            transform: translateY(-3px);
        }

    </style>

</body>