<% layout("/layouts/boilerplate") %>

<body>

    <!-- LISTING TITLE -->
    <h2 class="mb-4 fw-bold text-center text-danger">
        <%= listing.title %>
    </h2>

    <!-- LISTING SECTION -->
    <div class="row mb-5">
        <div class="col-md-8 offset-md-2">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- IMAGE -->
                <img src="<%= listing.image.url %>"
                    class="img-fluid show-image"
                    alt="listing_image">

                <div class="card-body p-4">

                    <!-- OWNER -->
                    <p class="card-text mb-2">
                        Owned by:
                        <span class="fw-semibold">
                            <i>@<%= listing.owner.username %></i>
                        </span>
                    </p>

                    <!-- DESCRIPTION -->
                    <p class="card-text text-muted">
                        <%= listing.description %>
                    </p>

                    <!-- PRICE -->
                    <h4 class="fw-bold text-danger mb-3">
                        ₹<%= listing.price.toLocaleString("en-IN") %>
                    </h4>

                    <!-- LOCATION -->
                    <p class="card-text">
                        <i class="bi bi-geo-alt-fill text-danger"></i>
                        <%= listing.location %>, <%= listing.country %>
                    </p>

                    <!-- EDIT & DELETE -->
                    <% if(currentUser && listing.owner._id.equals(currentUser._id)) { %>

                        <div class="d-flex gap-3 mt-4">

                            <form method="get"
                                action="/listings/<%= listing._id %>/edit">

                                <button class="btn btn-dark rounded-pill px-4">
                                    Edit
                                </button>

                            </form>

                            <form method="post"
                                action="/listings/<%= listing._id %>?_method=DELETE">

                                <button class="btn btn-danger rounded-pill px-4">
                                    Delete
                                </button>

                            </form>

                        </div>

                    <% } %>
        </div>
    </div>

    <hr class="my-4">

    <!--------------------------------------REVIEW FORM--------------------------------------->

    <% if(currentUser) { %>

        <h4 class="fw-bold text-center text-danger mb-4"> Leave a Review </h4>

        <form action="/listings/<%= listing._id %>/reviews" method="post" novalidate class="needs-validation" >

         <!-- RATING -->
        <div class="mt-3">
            <label for="rating" class="form-label fw-semibold"> Rating </label>
            <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />   
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
        </div>


                                <!-- COMMENT -->
                                <div class="mb-4">

                                    <label for="comment"
                                        class="form-label fw-semibold">

                                        Your Experience

                                    </label>

                                    <textarea name="review[comment]"
                                        id="comment"
                                        rows="4"
                                        class="form-control rounded-3"
                                        placeholder="Write your review here..."
                                        required></textarea>

                                </div>

                                <!-- BUTTON -->
                                <div class="text-center">

                                    <button class="btn btn-danger rounded-pill px-5">
                                        Submit Review
                                    </button>

                                </div>

                            </form>

                        </div>

    <% } else { %>

                        <!-- LOGIN MESSAGE -->
                        <div class="text-center mt-4">

                            <p class="text-muted mb-2">
                                Login to leave a review
                            </p>

       <a href="/login?redirect=/listings/<%= listing._id %>"
   class="btn btn-outline-danger rounded-pill px-4">
   Login
</a>

                        </div>

                    <% } %>

                </div>
            </div>

    <!-- REVIEWS SECTION -->
    <div class="row mb-5">

        <div class="col-md-10 offset-md-1">

            <h3 class="text-center fw-bold text-danger mb-5">
                Guest Reviews
            </h3>

            <% if(!listing.reviews || listing.reviews.length === 0) { %>

                <p class="text-center text-muted">
                    No reviews yet. Be the first to review!
                </p>

            <% } else { %>

                <div class="row g-4">

                    <% for(let review of listing.reviews) { %>

                        <div class="col-md-6 d-flex">

                            <!-- REVIEW CARD -->
                            <div class="card border-0 shadow-sm rounded-4 p-3 w-100 d-flex flex-column">

                                <div class="card-body d-flex flex-column justify-content-between">

                                    <!-- TOP -->
                                    <div>

                                        <!-- USER + RATING -->
                                        <div class="d-flex justify-content-between align-items-start mb-3">

                                            <div>

                                                <h5 class="mb-1 fw-bold">
                                                    @<%= review.author ? review.author.username : "Anonymous" %>
                                                </h5>

                                                <small class="text-muted">

                                                    <%= review.createdAt
                                                        ? review.createdAt.toDateString()
                                                        : "Recently" %>

                                                </small>

                                            </div>

                                            <span class="badge bg-danger rounded-pill px-3 py-2">

                                                <%= review.rating %> ⭐

                                            </span>

                                        </div>

                                        <!-- COMMENT -->
                                        <p class="text-muted review-comment">

                                            <%= review.comment %>

                                        </p>

                                    </div>

                                    <!-- DELETE BUTTON -->
                                    <% if(currentUser && review.author &&
                                        review.author._id.equals(currentUser._id)) { %>

                                        <form method="post"
                                            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">

                                            <button class="btn btn-sm btn-dark rounded-pill px-3 mt-3">
                                                Delete
                                            </button>

                                        </form>

                                    <% } %>

                                </div>

                            </div>

                        </div>

                    <% } %>

                </div>

            <% } %>

        </div>

    </div>


    <!-- CUSTOM CSS -->
<style>

    body{
        background: #f8f9fa;
    }

    /* LISTING IMAGE */
    .show-image {
        height: 460px;
        width: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .card:hover .show-image{
        transform: scale(1.02);
    }

    /* MAIN CARD */
    .card {
        border: none !important;
        border-radius: 28px !important;
        overflow: hidden;
        background: #fff;
        transition: all 0.35s ease;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 45px rgba(0,0,0,0.12) !important;
    }

    /* TITLE */
    h2{
        font-size: 2.3rem;
        letter-spacing: 0.5px;
        margin-top: 1rem;
    }

    /* OWNER */
    .card-text span{
        color: #ff385c;
    }

    /* PRICE */
    h4{
        font-size: 2rem;
    }

    /* REVIEW FORM SECTION */
    form{
        margin-top: 1rem;
    }

    textarea.form-control{
        border-radius: 18px !important;
        border: 1px solid #e5e5e5;
        padding: 1rem;
        resize: none;
        transition: all 0.3s ease;
        box-shadow: none !important;
    }

    textarea.form-control:focus{
        border-color: #ff385c;
        box-shadow: 0 0 0 4px rgba(255,56,92,0.12) !important;
    }

    /* BUTTONS */
    .btn-danger{
        background: linear-gradient(135deg,#ff385c,#ff5a5f);
        border: none;
        transition: all 0.3s ease;
        font-weight: 600;
    }

    .btn-danger:hover{
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(255,56,92,0.3);
    }

    .btn-dark{
        transition: all 0.3s ease;
    }

    .btn-dark:hover{
        transform: translateY(-2px);
    }

    /* REVIEW TITLE */
    h3,h4{
        letter-spacing: 0.3px;
    }

    /* REVIEW CARDS */
    .review-comment {
        line-height: 1.9;
        font-size: 0.97rem;
        color: #555 !important;
        word-break: break-word;
    }

    .col-md-6 .card{
        background: #ffffff;
        border: 1px solid rgba(0,0,0,0.04) !important;
        transition: all 0.35s ease;
    }

    .col-md-6 .card:hover{
        transform: translateY(-6px);
        box-shadow: 0 18px 35px rgba(0,0,0,0.08) !important;
    }

    /* RATING BADGE */
    .badge{
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        background: linear-gradient(135deg,#ff385c,#ff6b6b) !important;
        box-shadow: 0 6px 15px rgba(255,56,92,0.25);
    }

    /* REVIEW SECTION */
    .row.g-4{
        margin-top: 0.5rem;
    }

    /* LABELS */
    .form-label{
        font-size: 0.95rem;
        color: #444;
    }

    /* HR */
    hr{
        opacity: 0.08;
    }

    /* STAR RATING ALIGN */
    .starability-slot{
        transform: scale(1.05);
        margin-top: 0.4rem;
    }

    /* LOGIN BOX */
    .text-center.mt-4{
        background: #fff5f6;
        padding: 1.5rem;
        border-radius: 18px;
    }

    /* RESPONSIVE */
    @media(max-width:768px){

        h2{
            font-size: 1.8rem;
        }

        .show-image{
            height: 280px;
        }

        .card-body{
            padding: 1.4rem !important;
        }

        .badge{
            font-size: 0.75rem;
        }
    }

</style>

</body>